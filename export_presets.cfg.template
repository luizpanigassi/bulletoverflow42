html/head_include="<script>
// Prototipo de matchmaking pro browser: cada aba gera um userId aleatorio,
// entra na fila (/matchmaking/queue) e, ao ser pareada, monta a sessao e
// chama window.initGameSession (o proprio Godot registra esse callback em
// character_select.gd:_ready(), que roda assim que a engine sobe).
(function () {
	function randomGuestId() {
		return 'guest-' + Math.floor(Math.random() * 1e9);
	}

	function waitForBridgeThenInit(sessionJson) {
		if (typeof window.initGameSession === 'function') {
			console.log('[bootstrap] chamando initGameSession');
			window.initGameSession(sessionJson);
			return;
		}
		setTimeout(function () { waitForBridgeThenInit(sessionJson); }, 100);
	}

	function startMatchmaking() {
		var userId = randomGuestId();
		var queueUrl = 'ws://' + location.hostname + ':3000/matchmaking/queue?userId=' + userId + '&characterId=adventurer';
		var queueSocket = new WebSocket(queueUrl);

		queueSocket.onerror = function () {
			console.log('[bootstrap] erro conectando na fila de matchmaking');
		};

		queueSocket.onmessage = function (event) {
			var data = JSON.parse(event.data);
			if (data.type !== 'match_found') return;

			var session = {
				mode: 'online',
				match_id: data.match_id,
				arena_id: data.arena_id,
				seed: data.seed,
				host_id: '',
				websocket_url: data.websocket_url,
				game_type: 'pvp',
				bot_difficulty: 'easy',
				local_player_slot: data.slot,
				players: [
					{ user_id: 'p1', slot: 1, character_id: 'adventurer', ready: true, username: 'Player 1', is_bot: false },
					{ user_id: 'p2', slot: 2, character_id: 'adventurer', ready: true, username: 'Player 2', is_bot: false }
				]
			};

			waitForBridgeThenInit(JSON.stringify(session));
		};
	}

	startMatchmaking();
}());
</script>
