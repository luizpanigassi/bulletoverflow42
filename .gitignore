# Godot 4+ specific ignores
.godot/
/android/

# Segredos locais (nunca commitar; .env.example fica versionado)
.env
.env.*
!.env.example
EMAIL_CREDENTIALS.local.md
TEAM_SECRETS.local.md

# Export presets credentials
export_presets.cfg

# Node
node_modules/
/server/dist/

# Uploads de usuário (avatares etc.) — conteúdo gerado em runtime, não versionar
/server/uploads/

# Artefatos locais do Makefile (logs, perfis de Chrome de teste, exports soltos)
*.make-tmp/
/play/

# Mono / C#
.mono/
data_*/
mono_crash.*.json

# Build folders
bin/
obj/

# Visual Studio / Rider
.vscode/
.idea/
*.csproj
*.sln
*.user
*.dotSettings

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Godot export files
*.apk
*.aab
*.ipa
*.exe
*.x86_64
*.zip

# Linux binaries
*.x86_32

# Mac binaries
*.app

# Certificados locais do Docker/Nginx
docker/nginx/certs/*.crt
docker/nginx/certs/*.key
docker/nginx/certs/*.pem
docker/nginx/certs/*.p12
docker/nginx/certs/*.pfx
docker/nginx/certs/*.csr
docker/nginx/certs/*.srl
