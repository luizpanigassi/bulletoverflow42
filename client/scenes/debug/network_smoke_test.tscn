[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_smoke"]
script/source = "extends Node

# Cena de smoke test manual: valida a conexão WebSocket real entre o client
# Godot e o server local, sem passar por matchmaking (ver server/src/main.ts,
# que fixa a match \"smoke_test\" no boot).
#
# Uso: rodar duas instâncias apontando pra slots diferentes, ex.:
#   godot --path . client/scenes/debug/network_smoke_test.tscn -- --slot=1
#   godot --path . client/scenes/debug/network_smoke_test.tscn -- --slot=2
# Com o server rodando (npm run dev). O envio é pelo TERMINAL (não pela
# janela do Godot): digite um texto em qualquer um dos dois terminais e
# aperte Enter pra mandar; Enter vazio manda um \"ping\". Isso evita ter que
# alternar foco entre as janelas gráficas pra testar.

@export var server_host := \"127.0.0.1\"
@export var server_port := 3000
@export var match_id := \"smoke_test\"

var slot := 1
var _stdin_thread: Thread

@onready var status_label: Label = $StatusLabel

func _ready() -> void:
	slot = _read_slot_arg()
	status_label.text = \"slot %d: conectando...\" % slot

	NetworkClient.network_connected.connect(_on_connected)
	NetworkClient.network_disconnected.connect(_on_disconnected)
	NetworkClient.event_received.connect(_on_event_received)

	var url := \"ws://%s:%d/matches/%s?slot=%d\" % [server_host, server_port, match_id, slot]
	NetworkClient.connect_to_server(url)

	_stdin_thread = Thread.new()
	_stdin_thread.start(_read_stdin_loop)

func _read_slot_arg() -> int:
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with(\"--slot=\"):
			return int(arg.substr(\"--slot=\".length()))
	return 1

func _on_connected() -> void:
	status_label.text = \"slot %d: conectado! Digite no terminal e aperte Enter pra mandar.\" % slot

func _on_disconnected() -> void:
	status_label.text = \"slot %d: desconectado\" % slot

func _on_event_received(data: Dictionary) -> void:
	print(\"[SmokeTest slot %d] recebido: %s\" % [slot, data])
	status_label.text = \"slot %d: recebeu -> %s\" % [slot, data]

# Roda numa thread separada porque read_string_from_stdin() bloqueia — se
# fosse chamada direto no loop principal, travaria o _process()/rendering.
func _read_stdin_loop() -> void:
	# stdin fechado (EOF) faz read_string_from_stdin() voltar vazio na hora,
	# sem bloquear — sem essa checagem de tempo o loop giraria pra sempre
	# mandando \"ping\". Um Enter vazio de verdade num terminal interativo
	# leva bem mais que 2ms pra chegar, então não é confundido com EOF.
	var instant_empty_streak := 0
	while true:
		var t0 := Time.get_ticks_usec()
		var line := OS.read_string_from_stdin(1024).strip_edges()
		var elapsed_ms := (Time.get_ticks_usec() - t0) / 1000.0

		if line.is_empty():
			if elapsed_ms < 2.0:
				instant_empty_streak += 1
				if instant_empty_streak >= 3:
					break
				continue
			instant_empty_streak = 0
			call_deferred(\"_send_string_message\", \"ping\")
		else:
			instant_empty_streak = 0
			call_deferred(\"_send_string_message\", line)

func _send_string_message(text: String) -> void:
	print(\"[SmokeTest slot %d] enviando: %s\" % [slot, text])
	NetworkClient.send_message({
		\"type\": \"chat_test\",
		\"from_slot\": slot,
		\"message\": text,
	})
"

[node name="NetworkSmokeTest" type="Node"]
script = SubResource("GDScript_smoke")

[node name="StatusLabel" type="Label" parent="."]
offset_left = 20.0
offset_top = 20.0
offset_right = 900.0
offset_bottom = 60.0
text = "conectando..."
