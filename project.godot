; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bullet Overflow"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://client/icon.svg"

[autoload]

MatchData="*res://client/scripts/system/match_data.gd"
GameEvents="*res://client/scripts/system/game_events.gd"
NetworkClient="*res://client/scripts/network/network_client.gd"
MockMatchServer="*res://client/scripts/mock_server/mock_match_server.gd"
NetworkInputSender="*res://client/scripts/network/network_input_sender.gd"
MatchEventReceiver="*res://client/scripts/system/match_event_receiver.gd"
NetworkPlayerSynchronizer="*res://client/scripts/network/network_player_synchronizer.gd"
NetworkProjectileSynchronizer="*res://client/scripts/network/network_projectile_synchronizer.gd"
NetworkPowerupSynchronizer="*res://client/scripts/network/network_powerup_synchronizer.gd"
PlayerInputBuffer="*res://client/scripts/network/player_input_buffer.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[global_group]

players=""
spawn_points=""
walls=""
powerup_spawns=""
projectiles=""

